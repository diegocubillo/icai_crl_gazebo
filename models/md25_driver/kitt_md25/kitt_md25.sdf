<?xml version="1.0" ?>

<sdf version="1.9">
  <model name="kitt" canonical_link="car_body">
    <include merge="true">
      <uri>package://icai_crl_description/models/robots/kitt</uri>
    </include>

    <!-- MD25 driver plugin -->
    <plugin
      filename="md25_plugin"
      name="icai_crl_gazebo::MD25Plugin">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <motor_static_friction>0.07</motor_static_friction>     <!-- Similar value to the one in icai_crl_description -->
      <motor_viscous_friction>0.0009</motor_viscous_friction> <!-- Similar value to the one in icai_crl_description -->

    </plugin>
  </model>
</sdf>
